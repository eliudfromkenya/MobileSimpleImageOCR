<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="SimpleImageOCR.MainPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             Title="Simple Image OCR"
             Style="{StaticResource ContentPageStyle}">

    <ScrollView>
        <Grid Padding="20" RowSpacing="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <Border Grid.Row="0" 
                   BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                   CornerRadius="20"
                   HasShadow="True"
                   Padding="25"
                   Margin="0,0,0,10">
                <StackLayout Spacing="12">
                    <Label Text="📸 Eliud's OCR" 
                           FontSize="32" 
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center" />
                    <Label Text="Extract text from images with AI precision" 
                           FontSize="16" 
                           TextColor="White"
                           HorizontalOptions="Center"
                           Opacity="0.9" />
                </StackLayout>
            </Border>

            <!-- Status Section -->
            <Border Grid.Row="1" 
                   BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray800}}"
                   CornerRadius="15"
                   HasShadow="True"
                   Padding="20"
                   Margin="0,0,0,5">
                <StackLayout Orientation="Horizontal" Spacing="15">
                    <ActivityIndicator IsVisible="{Binding IsProcessing}" 
                                     IsRunning="{Binding IsProcessing}"
                                     Color="{StaticResource Primary}"
                                     WidthRequest="24"
                                     HeightRequest="24" />
                    <Label Text="{Binding StatusMessage}" 
                           FontSize="15"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"
                           VerticalOptions="Center"
                           FlexLayout.Grow="1" />
                </StackLayout>
            </Border>

            <!-- Action Cards Section -->
            <Grid Grid.Row="2" ColumnSpacing="20" RowSpacing="20" Margin="0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Take Photo Card -->
                <Border Grid.Row="0" Grid.Column="0"
                       BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray800}}"
                       CornerRadius="20"
                       HasShadow="True"
                       Padding="0"
                       HeightRequest="140">
                    <Button Command="{Binding TakePhotoCommand}"
                            BackgroundColor="Transparent"
                            BorderWidth="0"
                            IsEnabled="{Binding IsProcessing, Converter={toolkit:InvertedBoolConverter}}"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                        <Button.Text>
                            <![CDATA[📷
Take Photo]]>
                        </Button.Text>
                        <Button.Triggers>
                            <Trigger TargetType="Button" Property="IsPressed" Value="True">
                                <Setter Property="Scale" Value="0.95" />
                            </Trigger>
                        </Button.Triggers>
                    </Button>
                </Border>

                <!-- Pick Photo Card -->
                <Frame Grid.Row="0" Grid.Column="1"
                       BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray800}}"
                       CornerRadius="20"
                       HasShadow="True"
                       Padding="0"
                       HeightRequest="140">
                    <Button Command="{Binding PickPhotoCommand}"
                            BackgroundColor="Transparent"
                            BorderWidth="0"
                            IsEnabled="{Binding IsProcessing, Converter={toolkit:InvertedBoolConverter}}"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                        <Button.Text>
                            <![CDATA[🖼️
Pick Photo]]>
                        </Button.Text>
                        <Button.Triggers>
                            <Trigger TargetType="Button" Property="IsPressed" Value="True">
                                <Setter Property="Scale" Value="0.95" />
                            </Trigger>
                        </Button.Triggers>
                    </Button>
                </Frame>

                <!-- History Card -->
                <Frame Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                       BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray800}}"
                       CornerRadius="20"
                       HasShadow="True"
                       Padding="0"
                       HeightRequest="80">
                    <Button Command="{Binding ViewHistoryCommand}"
                            BackgroundColor="Transparent"
                            BorderWidth="0"
                            Text="📚 View History"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                        <Button.Triggers>
                            <Trigger TargetType="Button" Property="IsPressed" Value="True">
                                <Setter Property="Scale" Value="0.95" />
                            </Trigger>
                        </Button.Triggers>
                    </Button>
                </Frame>
            </Grid>

            <!-- Statistics Section -->
            <Frame Grid.Row="3" 
                   BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray700}}"
                   CornerRadius="15"
                   HasShadow="False"
                   Padding="20"
                   Margin="0,10,0,0">
                <StackLayout Orientation="Horizontal" Spacing="20">
                    <StackLayout Spacing="5" HorizontalOptions="FillAndExpand">
                        <Label Text="{Binding TotalSavedTexts}" 
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                               HorizontalOptions="Center" />
                        <Label Text="Texts Extracted" 
                               FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                               HorizontalOptions="Center" />
                    </StackLayout>
                </StackLayout>
            </Frame>

            <!-- Footer -->
            <StackLayout Grid.Row="4" Spacing="15" Margin="0,20,0,10">
                <Label Text="💡 Pro Tips" 
                       FontSize="16" 
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                       HorizontalOptions="Center" />
                <Label Text="• Ensure good lighting for better text recognition" 
                       FontSize="13" 
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                       HorizontalOptions="Center" />
                <Label Text="• Hold the camera steady and focus on the text" 
                       FontSize="13" 
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                       HorizontalOptions="Center" />
                <Label Text="• Clean text works better than handwritten text" 
                       FontSize="13" 
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                       HorizontalOptions="Center" />
            </StackLayout>
        </Grid>
    </ScrollView>

</ContentPage>
