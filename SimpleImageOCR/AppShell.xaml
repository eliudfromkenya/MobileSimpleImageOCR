<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SimpleImageOCR.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SimpleImageOCR"
    xmlns:views="clr-namespace:SimpleImageOCR.Views"
    Title="SimpleImageOCR">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <ShellContent
        Title="OCR Result"
        ContentTemplate="{DataTemplate views:OcrResultPage}"
        Route="OcrResultPage" />

    <ShellContent
        Title="History"
        ContentTemplate="{DataTemplate views:HistoryPage}"
        Route="HistoryPage" />

</Shell>
