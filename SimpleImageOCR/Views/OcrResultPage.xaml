<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="SimpleImageOCR.Views.OcrResultPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewmodels="clr-namespace:SimpleImageOCR.ViewModels"
             x:DataType="viewmodels:OcrResultViewModel"
             Title="OCR Result"
             BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="ActionCardStyle" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#2D2D30}" />
                <Setter Property="HasShadow" Value="True" />
                <Setter Property="CornerRadius" Value="15" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="10,5" />
            </Style>
            
            <Style x:Key="ActionButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="Padding" Value="20,15" />
                <Setter Property="CornerRadius" Value="15" />
                <Setter Property="BorderWidth" Value="0" />
            </Style>

            <Style x:Key="ShareOptionButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray700}}" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="Padding" Value="15,10" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Margin" Value="5" />
                <Setter Property="BorderWidth" Value="2" />
                <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                <Setter Property="MinimumWidthRequest" Value="120" />
                <Setter Property="HeightRequest" Value="40" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Frame Grid.Row="0" Style="{StaticResource ActionCardStyle}" Margin="15,10,15,5">
            <Grid Padding="20,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackLayout Grid.Column="0">
                    <Label Text="📄 Extracted Text" 
                           FontSize="20" 
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}" />
                    <Label Text="{Binding StatusMessage}" 
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                           IsVisible="{Binding StatusMessage, Converter={toolkit:IsStringNotNullOrEmptyConverter}}" />
                </StackLayout>

                <ActivityIndicator Grid.Column="1" 
                                 IsRunning="{Binding IsLoading}"
                                 IsVisible="{Binding IsLoading}"
                                 Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
            </Grid>
        </Frame>

        <!-- Text Content -->
        <ScrollView Grid.Row="1" Margin="15,5">
            <Frame Style="{StaticResource ActionCardStyle}">
                <Grid Padding="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Image Preview (if available) -->
                    <Frame Grid.Row="0" 
                           BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#3C3C3C}"
                           CornerRadius="10"
                           Padding="10"
                           Margin="0,0,0,15"
                           IsVisible="{Binding ImagePath, Converter={toolkit:IsStringNotNullOrEmptyConverter}}">
                        <Image Source="{Binding ImagePath}" 
                               Aspect="AspectFit" 
                               HeightRequest="150"
                               HorizontalOptions="Center" />
                    </Frame>

                    <!-- Extracted Text -->
                    <Editor Grid.Row="1"
                            Text="{Binding ExtractedText}"
                            TextChanged="OnTextChanged"
                            FontSize="16"
                            MinimumHeightRequest="200"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"
                            Placeholder="No text extracted..."
                            PlaceholderColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray600}}" />
                </Grid>
            </Frame>
        </ScrollView>

        <!-- Share Options -->
        <Frame Grid.Row="2" Style="{StaticResource ActionCardStyle}" Margin="15,5">
            <StackLayout Padding="20,15">
                <Label Text="📤 Share Options" 
                       FontSize="18" 
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"
                       Margin="0,0,0,10" />
                
                <CollectionView ItemsSource="{Binding ShareOptions}"
                                SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="5" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Button Text="{Binding .}"
                                    Style="{StaticResource ShareOptionButtonStyle}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:OcrResultViewModel}}, Path=ShareTextCommand}"
                                    CommandParameter="{Binding .}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:OcrResultViewModel}}, Path=IsLoading}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                        <Setter Property="Opacity" Value="0.6" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>
        </Frame>

        <!-- Action Buttons -->
        <Grid Grid.Row="3" Margin="15,5,15,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Frame Grid.Column="0" Style="{StaticResource ActionCardStyle}">
                <Button Text="💾 Save" 
                        Style="{StaticResource ActionButtonStyle}"
                        Command="{Binding SaveResultCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsSaved}" Value="True">
                            <Setter Property="Text" Value="✅ Saved" />
                            <Setter Property="IsEnabled" Value="False" />
                            <Setter Property="Opacity" Value="0.7" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding IsLoading}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                            <Setter Property="Opacity" Value="0.6" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Frame>

            <Frame Grid.Column="1" Style="{StaticResource ActionCardStyle}">
                <Button Text="📷 New Scan" 
                        Style="{StaticResource ActionButtonStyle}"
                        Command="{Binding NewScanCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsLoading}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                            <Setter Property="Opacity" Value="0.6" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Frame>

            <Frame Grid.Column="2" Style="{StaticResource ActionCardStyle}">
                <Button Text="📚 History" 
                        Style="{StaticResource ActionButtonStyle}"
                        Command="{Binding ViewHistoryCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsLoading}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                            <Setter Property="Opacity" Value="0.6" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Frame>
        </Grid>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="4" 
              BackgroundColor="#80000000" 
              IsVisible="{Binding IsLoading}">
            <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#2D2D30}"
                   CornerRadius="15"
                   Padding="30"
                   HorizontalOptions="Center"
                   VerticalOptions="Center">
                <StackLayout Orientation="Horizontal" Spacing="15">
                    <ActivityIndicator IsRunning="True" 
                                     Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                    <Label Text="Processing..." 
                           FontSize="16"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}" />
                </StackLayout>
            </Frame>
        </Grid>
    </Grid>
</ContentPage>